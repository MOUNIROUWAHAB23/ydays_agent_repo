# ---------------------------------------------------------------------------
# Copie ce fichier vers .env et renseigne tes valeurs.
# Le .env réel n'est JAMAIS versionné (voir .gitignore).
# ---------------------------------------------------------------------------

# --- LLM local (Ollama) ---
# En exécution native (hors Docker) : http://127.0.0.1:11434
# docker-compose.yml réinjecte host.docker.internal pour le conteneur.
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=llama3.1
EMBEDDING_MODEL=nomic-embed-text
LLM_TIMEOUT=600

# --- RAG ---
CHROMA_DIR=./chroma_db
DOCUMENTS_DIR=./data
COLLECTION_NAME=profil
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_K=6

# --- Outils externes ---
TAVILY_API_KEY=
NOTION_TOKEN=
NOTION_DATABASE_ID=

# --- Identité du candidat (signature des lettres) ---
CANDIDAT_NOM=

# --- Garde-fous ---
MAX_ITERATIONS=8
MAX_CORRECTIONS=2
LOG_LEVEL=INFO
